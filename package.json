{
  "name": "@mckabue/no-same-type-params",
  "version": "1.0.3",
  "description": "ESLint rule that disallows consecutive function parameters sharing the same type annotation. Encourages refactoring to object parameters.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "eslint-rule",
    "typescript",
    "parameters",
    "code-quality",
    "refactoring"
  ],
  "author": "Kabui Charles",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mckabue/no-same-type-params.git"
  },
  "bugs": {
    "url": "https://github.com/mckabue/no-same-type-params/issues"
  },
  "homepage": "https://github.com/mckabue/no-same-type-params#readme",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src vite.config.ts jest.config.cjs eslint.config.mjs package.json",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.6",
    "terser": "^5.46.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^5.1.0"
  }
}
